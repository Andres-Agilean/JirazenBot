# Display-only: used to build human-facing Jira deep links ({site}/browse/{KEY}) in later phases.
# The API is NOT called here -- see ATLASSIAN_CLOUD_ID below.
ATLASSIAN_SITE_URL=https://your-tenant.atlassian.net
# Jira Cloud id for this tenant. A scoped Atlassian API token is only authorized against the
# api.atlassian.com/ex/jira/{ATLASSIAN_CLOUD_ID} gateway, not against ATLASSIAN_SITE_URL directly
# (see docs/superpowers/specs/2026-08-10-teams-jira-zendesk-bot-design.md §2.1). This happens to be
# the same value as ZENDESK_JIRA_EXTERNAL_ID below, but the two are conceptually distinct (Jira
# site cloud id vs. how Zendesk's integration identifies the Jira connection) -- do not alias them.
ATLASSIAN_CLOUD_ID=00000000-0000-0000-0000-000000000000
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_ALLOWED_PROJECTS=AGL,AI,MDO,QZ,SC
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_JIRA_EXTERNAL_ID=00000000-0000-0000-0000-000000000000
# Field strategy is primary until "Manage links" is enabled in Zendesk (links API returns 403 --
# see design addendum §2 and §7 item 2).
RESOLVER_ORDER=jira_zendesk_id_field,zendesk_links
JIRA_ZENDESK_ID_FIELD=customfield_10356
BUNDLE_TOKEN_BUDGET=25000
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=2048
